# ===============================
# APP
# ===============================
NODE_ENV=production
APP_NAME=media-service
PORT=3000

# ===============================
# DATABASE
# ===============================
DB_HOST=media-db
DB_PORT=5432
DB_NAME=media-db
DB_USER=postgres
DB_PASSWORD=postgres

# ===============================
# SECURITY / AUTH
# ===============================
JWT_SECRET=super-secret-key
JWT_EXPIRES_IN=1h

# ===============================
# API / GATEWAY
# ===============================
API_PREFIX=/api
API_GATEWAY_URL=http://gateway:3000

# ===============================
# LOGGING
# ===============================
LOG_LEVEL=info

# ===============================
# FEATURE FLAGS
# ===============================
ENABLE_SWAGGER=false
